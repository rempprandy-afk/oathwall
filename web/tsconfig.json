{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"],
      "@oathwall/core": ["../packages/core/src/index.ts"],
      "@oathwall/policy": ["../worker/src/policy.ts"],
      "@oathwall/recover": ["../worker/src/recover.ts"],
      "@oathwall/grant-store": ["../worker/src/grant-store.ts"],
      "@oathwall/command-files": ["../worker/src/command-files.ts"],
      "@oathwall/settings-store": ["../worker/src/settings-store.ts"],
      "@oathwall/thesis": ["../worker/src/thesis-policy.ts"],
      "@oathwall/feed-history": ["../worker/src/read-feed-history.ts"],
      "@oathwall/identity-store": ["../worker/src/identity-store.ts"],
      "@oathwall/follow-store": ["../worker/src/follow-store.ts"],
      "@oathwall/llm": ["../worker/src/llm.ts"],
      "@oathwall/settings": ["../worker/src/settings.ts"],
      "@oathwall/home": ["../worker/src/home.ts"],
      "@oathwall/db": ["../worker/src/db.ts"],
      "@oathwall/backtest": ["../worker/src/backtest.ts"],
      "@oathwall/backtest-scenario": ["../worker/src/backtest-scenario.ts"],
      "@oathwall/limits": ["../worker/src/limits.ts"],
      "@oathwall/playground-api": ["../worker/src/playground-api.ts"],
      "@oathwall/wall-battery": ["../worker/src/wall-battery.ts"],
      "@oathwall/strategies/*": ["../worker/src/strategies/*"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    "next-env.d.ts",
    ".next-build/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
