# oathwall worker environment — copy to .env and fill in what you use.
#
# ~/.oathwall/settings.json WINS over everything here: a variable is only read
# when that setting is missing from the file. `npm run dev:worker` loads .env;
# the full list of variables is in worker/src/settings.ts.
#
# COMMENT OUT what you don't set — never leave a switch or a number blank. A
# blank switch reads as false (OATHWALL_PAPER_TRADING= turns paper OFF) and a
# blank number reads as 0 (OATHWALL_MAX_IMPACT_BPS= turns the impact guard OFF).

# ── trading ───────────────────────────────────────────────────────────────
# Pimlico key — without it the agent can only paper trade.
OATHWALL_BUNDLER_API_KEY=
# steady-basket (majors) · trencher (new PancakeSwap launches) · even-keel · dip-hunter
OATHWALL_STRATEGY=steady-basket
OATHWALL_PAPER_TRADING=true
OATHWALL_PAPER_START_USDG=1000
OATHWALL_TICK_SECONDS=60
# OATHWALL_SLIPPAGE_BPS=
OATHWALL_SWAP_VENUE=pancakeswap

# ── memecoins (trencher) ──────────────────────────────────────────────────
# Discovery feed. Bitquery V2 access token (ory_at_…) from account.bitquery.io,
# or an oathwall holder token, which covers discovery too.
BITQUERY_API_KEY=
OATHWALL_TOKEN=
OATHWALL_DISCOVERY_ENABLED=true
OATHWALL_DISCOVERY_INTERVAL_MIN=10
# Let trencher trade for real, not only on paper.
OATHWALL_TRENCHER_LIVE=false

# ── chain ─────────────────────────────────────────────────────────────────
OATHWALL_RPC_MAINNET=

# ── the agent's brain (chat, strategist) ──────────────────────────────────
OATHWALL_LLM_PROVIDER=
OATHWALL_LLM_API_KEY=
OATHWALL_LLM_MODEL=

# ── telegram ──────────────────────────────────────────────────────────────
OATHWALL_TELEGRAM_ENABLED=false
OATHWALL_TELEGRAM_BOT_TOKEN=
OATHWALL_TELEGRAM_ALLOWLIST=
